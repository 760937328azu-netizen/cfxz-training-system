# 展示模式环境变量
# 用途：纯展示版本，不连接后端 API，所有数据预填在 localStorage 中
# 构建：vite build --mode demo

# 启用展示模式（激活 src/lib/demo-mode.ts 中的初始化逻辑）
VITE_DEMO_MODE=true

# 注意：必须显式覆盖 VITE_API_BASE_URL 为空值
# Vite 在所有模式下都会加载 .env.local，如果不显式覆盖，
# .env.local 中的 VITE_API_BASE_URL=http://localhost:4000/api 会生效，
# 导致 isApiMode() 返回 true，展示模式尝试调用不存在的后端 API
VITE_API_BASE_URL=
