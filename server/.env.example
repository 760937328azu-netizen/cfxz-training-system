# ──────────────────────────────────────────────
# 环境变量模板（可提交 Git）
# 复制此文件为 .env 并填入实际值
# ──────────────────────────────────────────────

# Supabase 连接池 URL（运行时用，端口 6543）
# 格式: postgresql://postgres.[项目引用]:[密码]@aws-0-[区域].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase 直连 URL（Prisma 迁移用，端口 5432）
# 格式: postgresql://postgres:[密码]@db.[项目引用].supabase.co:5432/postgres
DIRECT_URL=

# JWT 密钥（随机 64 字符，可用 openssl rand -base64 48 生成）
JWT_SECRET=

# 服务端口
PORT=4000
